GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=low
GROQ_MAX_CHAT_TOKENS=700
VENICE_API_KEY=your_venice_api_key
VENICE_PARTNER_MODEL=gemma-4-uncensored
VENICE_API_BASE_URL=https://api.venice.ai/api/v1
RESEND_API_KEY=your_resend_sending_key
EMAIL_FROM=DilSe <notifications@baatdilse.com>
APP_URL=https://www.baatdilse.com/app
EMAIL_NOTIFICATION_POLL_SECONDS=300
VAPID_PUBLIC_KEY=your_urlsafe_vapid_public_key
VAPID_PRIVATE_KEY=your_urlsafe_vapid_private_key
VAPID_SUBJECT=mailto:notifications@baatdilse.com
PUSH_NOTIFICATION_POLL_SECONDS=2
# Native Android notifications. Paste the Firebase service-account JSON as one
# Railway variable, or use its standard base64 encoding in the second variable.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_BASE64=
MOBILE_PUSH_NOTIFICATION_POLL_SECONDS=2
ANDROID_LATEST_VERSION=1.0.2
ANDROID_LATEST_BUILD=3
ANDROID_MINIMUM_BUILD=1
ANDROID_DOWNLOAD_URL=https://www.baatdilse.com/downloads/DilSe-latest.apk
ANDROID_RELEASE_NOTES=Android and web activity labels for administrators, plus app installation reporting.
TELEGRAM_BOT_TOKEN=your_botfather_token
TELEGRAM_ADMIN_USER_IDS=your_numeric_telegram_user_id
# Optional after the private forum group is connected with /connect.
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_OUTBOX_POLL_SECONDS=1.5
TELEGRAM_UPDATE_TIMEOUT_SECONDS=20
ADMIN_API_KEY=replace-with-a-long-random-secret
VISITOR_TRACKING_SECRET=replace-with-a-separate-long-random-secret
BACKEND_URL=http://127.0.0.1:8000
DILSE_SHOW_HUMAN_HANDOFF_UI=false
DILSE_AI_REPLY_MIN_DELAY_SECONDS=2.5
DATABASE_PATH=dilse.db
AUTH_SESSION_DAYS=7
CHAT_HISTORY_LIMIT=20
VISITOR_RETENTION_DAYS=30
VISITOR_SESSION_MINUTES=30
VISITOR_LIVE_SECONDS=60
